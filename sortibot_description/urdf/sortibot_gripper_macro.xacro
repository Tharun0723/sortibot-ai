<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sortibot_gripper" params="parent:=tool0">

    <xacro:property name="palm_length" value="0.080"/>
    <xacro:property name="palm_width" value="0.100"/>
    <xacro:property name="palm_height" value="0.025"/>
    <xacro:property name="finger_length" value="0.070"/>
    <xacro:property name="finger_width" value="0.015"/>
    <xacro:property name="finger_height" value="0.060"/>
    <xacro:property name="finger_travel" value="0.025"/>
    <xacro:property name="finger_offset" value="0.0575"/>

    <link name="gripper_mount">
      <visual>
        <geometry>
          <box size="${palm_length} ${palm_width} ${palm_height}"/>
        </geometry>
        <material name="sortibot_palm_grey">
          <color rgba="0.35 0.38 0.42 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${palm_length} ${palm_width} ${palm_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.35"/>
        <inertia ixx="0.0003" ixy="0" ixz="0"
                 iyy="0.0003" iyz="0" izz="0.0003"/>
      </inertial>
    </link>

    <joint name="sortibot_gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_mount"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="left_finger">
      <visual>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
        <material name="sortibot_finger_blue">
          <color rgba="0.1 0.35 0.85 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00008" ixy="0" ixz="0"
                 iyy="0.00008" iyz="0" izz="0.00008"/>
      </inertial>
    </link>

    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_mount"/>
      <child link="left_finger"/>
      <origin xyz="0 ${finger_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="${finger_travel}"
             effort="20" velocity="0.05"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="right_finger">
      <visual>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
        <material name="sortibot_finger_orange">
          <color rgba="0.95 0.4 0.08 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00008" ixy="0" ixz="0"
                 iyy="0.00008" iyz="0" izz="0.00008"/>
      </inertial>
    </link>

    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_mount"/>
      <child link="right_finger"/>
      <origin xyz="0 -${finger_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="${finger_travel}"
             effort="20" velocity="0.05"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

  </xacro:macro>
</robot>
